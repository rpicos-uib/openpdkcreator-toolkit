# Real, third-party IHP PDK data -- fetched locally via ihp/fetch.py,
# never committed. See docs/ihp_vs_open_pdks.md and README.md.
data/

# This user's own saved edits (DRC Rules/Magic Types/LEF pins) -- see
# project_io.py's own docstring for why these live separate from data/
# and are still kept out of git (derived from real, third-party PDK
# starting values, not this project's own original code).
saves/

# Real, open_pdks-format write-back output (export.py) -- patched
# real .lef files, mirroring pdk_root's own real relative paths.
# Derived from the real, third-party PDK data, not committed, same
# reasoning as data/ and saves/.
export/

__pycache__/
*.pyc
.venv/

# nix-portable's own runtime cache -- lands here (not a real home dir)
# because this container's own passwd entry sets HOME to this project's
# own bind-mounted directory. Unrelated to this project's own code.
.cache/
