--- custom_rules.drc ---
# New, minimal DRC deck.
#
# Real rules authored via the DRC Rules tab's own New Rule action land
# in custom_rules.drc, entirely generated by pdklib/drc_writer.py's own
# render_custom_drc_file -- see that function's own docstring.
#
# A real report() call, not just the rules below, is what makes this
# file genuinely runnable standalone (`klayout -b <gds> -r
# custom_rules.drc`) -- confirmed live: without one, a bare, real
# `region.output("RULE_ID", "description")` call fails at runtime
# (`TypeError: no implicit conversion of String into Integer ... in
# LayerInfo::initialize`), because KLayout resolves the 2-string-arg
# report-database form of `.output()` only once a report destination
# is actually configured; `-rd output=<path>` alone does not do this
# by itself, the script itself has to read it via `$output`.
report("Custom DRC Rules", $output || "custom_rules_report.lyrdb")

# --- TE_W ---
te_w_l0 = input(200, 0)  # TopElectrode.drawing
r_te_w = te_w_l0.width(0.2.um)
r_te_w.output("TE_W", "minimum TopElectrode width")

# --- TE_VIA_ENC ---
te_via_enc_l0 = input(210, 0)  # ViaCut.drawing
te_via_enc_l1 = input(200, 0)  # TopElectrode.drawing
r_te_via_enc = te_via_enc_l0.enclosed(te_via_enc_l1, 0.1.um)
r_te_via_enc.output("TE_VIA_ENC", "minimum enclosure of via by TopElectrode")

# --- TE_AREA ---
te_area_l0 = input(200, 0)  # TopElectrode.drawing
r_te_area = te_area_l0.with_area(0, 0.05.um2)
r_te_area.output("TE_AREA", "minimum TopElectrode area")

# --- TE_OVERLAP ---
te_overlap_l0 = input(200, 0)  # TopElectrode.drawing
te_overlap_l1 = input(210, 0)  # ViaCut.drawing
r_te_overlap = te_overlap_l0.overlap(te_overlap_l1, 0.05.um)
r_te_overlap.output("TE_OVERLAP", "minimum overlap of TopElectrode by ViaCut")

# --- TE_MAXLEN ---
te_maxlen_l0 = input(200, 0)  # TopElectrode.drawing
r_te_maxlen = te_maxlen_l0.edges.with_length(0.05.um, nil)
r_te_maxlen.output("TE_MAXLEN", "maximum unsegmented TopElectrode edge length")

